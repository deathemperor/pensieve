{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pensieve",
	"account_id": "76f1666bfa8377c4a6ecd1c8993a37df",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "huuloc.com/*",
			"zone_name": "huuloc.com"
		},
		{
			"pattern": "huuloc.com",
			"zone_name": "huuloc.com"
		}
	],
	"triggers": {
		"crons": ["0 23 * * *", "0 * * * *", "*/5 * * * *", "*/10 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pensieve-db",
			"database_id": "b937d135-b3fe-438d-9a00-898e18c83df5",
		},
		{
			"binding": "HOL_DB",
			"database_name": "hol-archive",
			"database_id": "96e6aa9d-fff8-476d-a4db-07165c696bdf",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "pensieve-media",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "21adb2f7216e4fd9bed2f90f0c5d82e9",
		},
	],
	"observability": {
		"enabled": true,
	},
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	"migrations": [
		{
			"tag": "v1-openclaw",
			"new_sqlite_classes": ["OpenClawContainer"],
		},
		{
			"tag": "v2-remove-openclaw",
			"deleted_classes": ["OpenClawContainer"],
		},
	],
}
